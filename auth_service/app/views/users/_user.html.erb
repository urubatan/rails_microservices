<div id="<%= dom_id user %>">
  <p>
    <strong>Client:</strong>
    <%= user.client_id %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= user.email %>
  </p>

  <p>
    <strong>Name:</strong>
    <%= user.name %>
  </p>

  <p>
    <strong>Password hash:</strong>
    <%= user.password_hash %>
  </p>

</div>
